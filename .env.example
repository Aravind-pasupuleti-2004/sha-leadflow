# SHA LeadFlow AI — local configuration
# Copy this file to .env and replace every placeholder. Never commit .env.
# In production, set these values in the hosting provider's environment UI.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
APP_ENV=development
FLASK_APP=wsgi:app
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
# Local development fallback. Production must use PostgreSQL.
DATABASE_URL=sqlite:///instance/sha_leadflow.db
# Set to 1 when the app runs behind a trusted reverse proxy (Render does this).
TRUST_PROXY=0
# Set to 1 in production so session cookies are HTTPS-only.
SESSION_COOKIE_SECURE=0
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# First administrator (only used by `flask create-admin` / start-up bootstrap)
# Remove ADMIN_PASSWORD from the hosting environment after the first deploy.
# ---------------------------------------------------------------------------
ADMIN_NAME=SHA Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-first-run

# ---------------------------------------------------------------------------
# AI provider — free tiers only
# AI_PROVIDER: gemini | groq | none
# No automatic provider switching and no paid fallback is implemented.
# If the key/model is missing or the provider fails, deterministic fallback
# summaries are used instead.
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Set an explicit model available on your free tier. Verify current limits in
# Google AI Studio before changing. Example free-tier model ID (Oct 2026):
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 3.x thinking level: minimal, low, medium, or high. Leave empty for
# older Gemini 2.5 models, which use a different thinking parameter.
GEMINI_THINKING_LEVEL=minimal

# Optional Groq adapter (only used when AI_PROVIDER=groq).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=10
LEAD_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
# Comma-separated service areas. Locality matching is case-insensitive.
SERVICE_AREAS=Indiranagar,Koramangala,HSR Layout,Whitefield,Jayanagar,JP Nagar,Hebbal,Sarjapur Road,Electronic City,Yelahanka
# Leads at or above this deterministic score appear in the high-priority list.
HIGH_PRIORITY_THRESHOLD=80
# Optional JSON object deep-merged over the defaults in app/config.py.
# Example: SCORING_CONFIG_JSON={"weights":{"budget":25,"readiness":25,"urgency":20,"scope":15,"area":15}}
SCORING_CONFIG_JSON=

# Upload guards
MAX_CSV_BYTES=2097152
MAX_CSV_ROWS=1000

# ---------------------------------------------------------------------------
# WhatsApp Business Platform Cloud API
# ---------------------------------------------------------------------------
# Get these from Meta Business Manager > WhatsApp > API Setup
# WHATSAPP_ENABLED: Set to "true" to enable live sending (requires valid credentials)
# WHATSAPP_DRY_RUN: Set to "false" for live sending (default: "true" for safety)
# WHATSAPP_PHONE_NUMBER_ID: Your WhatsApp Business Phone Number ID
# WHATSAPP_ACCESS_TOKEN: Permanent or temporary access token
# WHATSAPP_API_VERSION: Graph API version (e.g., v20.0)
# WHATSAPP_VERIFY_TOKEN: Webhook verification token (set in Meta webhook config)
# WHATSAPP_APP_SECRET: App Secret from Meta App Dashboard (for signature verification)
# WHATSAPP_DEFAULT_TEMPLATE: Default template name for initial messages (optional)
# WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE: Template language code (default: en_US)
# WHATSAPP_MAX_MESSAGES_PER_RUN: Max messages per worker iteration (default: 50)
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_TEMPLATE=
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en_US
WHATSAPP_MAX_MESSAGES_PER_RUN=50

# ---------------------------------------------------------------------------
# Automation settings
# ---------------------------------------------------------------------------
# AUTOMATION_INITIAL_ENABLED: Enable/disable initial message sending (default: true)
# AUTOMATION_AUTO_OPT_IN: Auto-opt-in leads for testing (default: false, set true for local testing)
# ---------------------------------------------------------------------------
AUTOMATION_INITIAL_ENABLED=true
AUTOMATION_AUTO_OPT_IN=false
